   "task_id": "70e43539-fc2b-5bde-a0c6-9e9ceea16ac1",
   "attempt_id": "f4e95d95-4175-5fb9-9cf5-1a1bdac8db38",
   "name": "sql",
   "version": 1,
   "kind": "step",
   "content": {
    "sql": "SELECT fiscal_year, report_type, (operate_income - operate_cost) / operate_income AS gross_margin FROM income_statement WHERE report_type = '年报' AND fiscal_year BETWEEN 2021 AND 2025 ORDER BY fiscal_year",
    "columns": [
     {
      "name": "fiscal_year",
      "definition": "会计年度"
     },
     {
      "name": "gross_margin",
      "definition": "(营业收入 − 营业成本) ÷ 营业收入，比率，0.25 表示 25%"
     }
    ]
   },
