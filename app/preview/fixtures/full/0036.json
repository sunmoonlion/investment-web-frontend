    "after_rejection": {
     "reworks": 2,
     "then": "human",
     "back_to": null,
     "text": "重做，最多 2 次；仍不过，停下来问你"
    },
    "reserve": "0.05"
   },
   {
    "index": 3,
    "step_id": "sql_execute",
    "title": "执行 SQL",
    "summary": "执行查询，原样带回结果和数据版本",
    "uses": [
     {
      "artifact": "sql",
      "step": 2,
      "title": "生成 SQL"
