     "content": [
      {
       "rule": "资产 = 负债 + 所有者权益",
       "rule_id": "R01",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "流动资产 + 非流动资产 = 资产总计",
       "rule_id": "R02",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "流动负债 + 非流动负债 = 负债合计",
       "rule_id": "R03",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "营业收入 − 营业成本 − 各项费用 = 营业利润（允许其他收益）",
       "rule_id": "R04",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "利润总额 − 所得税 = 净利润",
       "rule_id": "R05",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "归母净利润 + 少数股东损益 = 净利润",
       "rule_id": "R06",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "经营 + 投资 + 筹资现金流 + 汇率影响 = 现金净增加额",
       "rule_id": "R07",
       "unbalanced": 0,
       "periods_checked": 3,
       "unbalanced_periods": []
      },
      {
       "rule": "期初现金 + 现金净增加额 = 期末现金",
