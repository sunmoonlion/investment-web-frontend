# App
NEXT_PUBLIC_APP_NAME=research
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# BFF 选型：frontend（前端承担）或 backend（后端承担）
# frontend → 登录跳 /api/auth/login，REDIRECT_URI 指向本服务
# backend  → 登录跳 NEXT_PUBLIC_API_URL/auth/login，REDIRECT_URI 指向后端
NEXT_PUBLIC_BFF_PROVIDER=frontend

# Casdoor (BFF 使用，不暴露给前端)
CASDOOR_ENDPOINT=https://casdoor.example.com
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_REDIRECT_URI=http://localhost:3000/api/auth/callback
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=app-research

# Redis (session 存储)
REDIS_URL=redis://localhost:6379
